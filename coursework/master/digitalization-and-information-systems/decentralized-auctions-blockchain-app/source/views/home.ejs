<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Home</title>
    <link rel="stylesheet" type="text/css" href="/styles.css">
</head>
<body>
    <div class="container">
        <div class="home-header">
            <h1>Welcome, <%= username %>!</h1>
        </div>
        <div class="home-buttons">
            <a href="/active" class="button">Browse Auctions</a>
            <% if (!isAdmin) { %>
                <a href="/create" class="button">Create Auction</a>
            <% } else { %>
                <a href="/approve" class="button">Approve Auctions</a>
            <% } %>
        </div>
    </div>
</body>
</html>