AVAL blh:\"Application Structure Viewpoint Help\"
IF (VAL blh = 1) {
 FONT color:black
TEXTBOX \"The application structure viewpoint shows the structure of one or more applications or comp"
	      "onents. This viewpoint is useful in designing or understanding the main structure of applications or "
	      "components and the associated data; e.g., to break down the structure of the system under constructio"
	      "n, or to identify legacy application components that are suitable for migration/integration.\" x:0.5c"
	      "m w:10cm h:t y:(y+1.8cm) line-break:words
FILL color:white
RECTANGLE x:(textx1-0.03cm) y:(texty1-0.01cm) w:(textw+0.01cm) h:(texth+0.01cm)
TEXT \"The application structure viewpoint shows the structure of one or more applications or compone"
	      "nts. This viewpoint is useful in designing or understanding the main structure of applications or com"
	      "ponents and the associated data; e.g., to break down the structure of the system under construction, "
	      "or to identify legacy application components that are suitable for migration/integration.\" x:0.5cm w"
	      ":10cm h:t y:(y+1.8cm) line-break:words
 POLYGON 3 x1:0.6cm y1:(y+1.1cm) x2:0.9cm y2:(y+1.1cm) x3:0.75cm y3:(y+1.4cm)
}
ELSE { 
 POLYGON 3 x1:0.6cm y1:(y+1.4cm) x2:0.9cm y2:(y+1.25cm) x3:0.6cm y3:(y+1.1cm)
}"

