AVAL blh:\"Goal Realization Viewpoint Help\"
IF (VAL blh = 1) {
 FONT color:black
TEXTBOX \"The goal realization viewpoint allows a designer to model the refinement of (high-level) go"
	      "als into more tangible goals, and the refinement of tangible goals into requirements or constraints t"
	      "hat describe the properties that are needed to realize the goals. The refinement of goals into sub-go"
	      "als is modeled using the aggregation relationship. The refinement of goals into requirements is model"
	      "ed using the realization relationship. In addition, the principles may be modeled that guide the refi"
	      "nement of goals into requirements.\" x:0.5cm w:10cm h:t y:(y+1.8cm) line-break:words
FILL color:white
RECTANGLE x:(textx1-0.03cm) y:(texty1-0.01cm) w:(textw+0.01cm) h:(texth+0.01cm)
 TEXT \"The goal realization viewpoint allows a designer to model the refinement of (high-level) goal"
	      "s into more tangible goals, and the refinement of tangible goals into requirements or constraints tha"
	      "t describe the properties that are needed to realize the goals. The refinement of goals into sub-goal"
	      "s is modeled using the aggregation relationship. The refinement of goals into requirements is modeled"
	      " using the realization relationship. In addition, the principles may be modeled that guide the refine"
	      "ment of goals into requirements.\" x:0.5cm w:10cm h:t y:(y+1.8cm) line-break:words
 POLYGON 3 x1:0.6cm y1:(y+1.1cm) x2:0.9cm y2:(y+1.1cm) x3:0.75cm y3:(y+1.4cm)
}
ELSE { 
 POLYGON 3 x1:0.6cm y1:(y+1.4cm) x2:0.9cm y2:(y+1.25cm) x3:0.6cm y3:(y+1.1cm)
}"

