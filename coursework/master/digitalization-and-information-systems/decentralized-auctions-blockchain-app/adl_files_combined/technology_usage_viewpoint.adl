	ATTRIBUTE <Organizational Viewpoint GraphRep>
	VALUE "GRAPHREP layer:1000 sizing:asymmetrical
 AVAL name:\"Name\" # model name
 AVAL type:\"Type\" # model type name
 AVAL count:\"Number of objects and relations\"
 SET y:0.5cm
 FONT \"Arial\" h:20pt color:black
 TEXT (name + \" (\" + type + \")\") x:0.5cm y:(y) w:l h:t
 SET y:(y + 20pt + 0.3cm)
 FONT \"Arial\" h:11pt color:black
 TEXT (\"Object count: \" + count) x:0.5cm y:(y) w:l h:t

SET y:1cm
FILL color:dodgerblue
RECTANGLE x:0.5cm y:(y+1cm) w:2.5cm h:0.5cm
FILL color:white
FONT color:white
TEXT \"Help\" x:1.5cm y:(y+1cm)

HOTSPOT \"Organizational Viewpoint Description\" x:0.5cm y:(y+1cm) w:2.5cm h:0.5cm

AVAL blh:\"Organizational Viewpoint Help\"
IF (VAL blh = 1) {
 FONT color:black
 TEXTBOX \"The organization viewpoint focuses on the (internal) organization of a company, department"
	      ", network of companies, or of another organizational entity. It is possible to present models in this"
	      " viewpoint as nested block diagrams, but also in a more traditional way, such as organizational chart"
	      "s. The organization viewpoint is very useful in identifying competencies, authority, and responsibili"
	      "ties in an organization.\" x:0.5cm w:10cm h:t y:(y+1.8cm) line-break:words
FILL color:white
RECTANGLE x:(textx1-0.03cm) y:(texty1-0.01cm) w:(textw+0.01cm) h:(texth+0.01cm)
 TEXT \"The organization viewpoint focuses on the (internal) organization of a company, department, n"
	      "etwork of companies, or of another organizational entity. It is possible to present models in this vi"
	      "ewpoint as nested block diagrams, but also in a more traditional way, such as organizational charts. "
	      "The organization viewpoint is very useful in identifying competencies, authority, and responsibilitie"
	      "s in an organization.\" x:0.5cm w:10cm h:t y:(y+1.8cm) line-break:words
 POLYGON 3 x1:0.6cm y1:(y+1.1cm) x2:0.9cm y2:(y+1.1cm) x3:0.75cm y3:(y+1.4cm)
}
ELSE { 
 POLYGON 3 x1:0.6cm y1:(y+1.4cm) x2:0.9cm y2:(y+1.25cm) x3:0.6cm y3:(y+1.1cm)
}
"

