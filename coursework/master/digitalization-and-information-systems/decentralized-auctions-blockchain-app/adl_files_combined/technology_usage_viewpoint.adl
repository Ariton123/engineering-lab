AVAL blh:\"Service Realization Viewpoint Help\"
IF (VAL blh = 1) {
 FONT color:black
 TEXTBOX \"The service realization viewpoint is used to show how one or more business services are re"
	      "alized by the underlying processes (and sometimes by application components). Thus, it forms the brid"
	      "ge between the business products viewpoint and the business process view. It provides a “view from th"
	      "e outside” on one or more business processes.\" x:0.5cm w:10cm h:t y:(y+1.8cm) line-break:words
FILL color:white
RECTANGLE x:(textx1-0.03cm) y:(texty1-0.01cm) w:(textw+0.01cm) h:(texth+0.01cm)
 TEXT \"The service realization viewpoint is used to show how one or more business services are reali"
	      "zed by the underlying processes (and sometimes by application components). Thus, it forms the bridge "
	      "between the business products viewpoint and the business process view. It provides a “view from the o"
	      "utside” on one or more business processes.\" x:0.5cm w:10cm h:t y:(y+1.8cm) line-break:words
 POLYGON 3 x1:0.6cm y1:(y+1.1cm) x2:0.9cm y2:(y+1.1cm) x3:0.75cm y3:(y+1.4cm)
}
ELSE { 
 POLYGON 3 x1:0.6cm y1:(y+1.4cm) x2:0.9cm y2:(y+1.25cm) x3:0.6cm y3:(y+1.1cm)
}"

