	ATTRIBUTE <Product Viewpoint GraphRep>
	VALUE "GRAPHREP layer:1000 sizing:asymmetrical
 AVAL name:\"Name\" # model name
 AVAL type:\"Type\" # model type name
 AVAL count:\"Number of objects and relations\"
 SET y:0.5cm
 FONT \"Arial\" h:20pt color:black
 TEXT (name + \" (\" + type + \")\") x:0.5cm y:(y) w:l h:t
 SET y:(y + 20pt + 0.3cm)
 FONT \"Arial\" h:11pt color:black
 TEXT (\"Object count: \" + count) x:0.5cm y:(y) w:l h:t

SET y:1cm
FILL color:dodgerblue
RECTANGLE x:0.5cm y:(y+1cm) w:2.5cm h:0.5cm
FILL color:white
FONT color:white
TEXT \"Help\" x:1.5cm y:(y+1cm)

HOTSPOT \"Product Viewpoint Description\" x:0.5cm y:(y+1cm) w:2.5cm h:0.5cm

AVAL blh:\"Product Viewpoint Help\"
IF (VAL blh = 1) {
 FONT color:black
 TEXTBOX \"The product viewpoint depicts the value that these products offer to the customers or othe"
	      "r external parties involved and shows the composition of one or more products in terms of the constit"
	      "uting (business, application, or technology) services, and the associated contract(s) or other agreem"
	      "ents. It may also be used to show the interfaces (channels) through which this product is offered, an"
	      "d the events associated with the product. A product viewpoint is typically used in product developmen"
	      "t to design a product by composing existing services or by identifying which new services have to be "
	      "created for this product, given the value a customer expects from it. It may then serve as input for "
	      "business process architects and others that need to design the processes and ICT realizing these prod"
	      "ucts.\" x:0.5cm w:10cm h:t y:(y+1.8cm) line-break:words
FILL color:white
RECTANGLE x:(textx1-0.03cm) y:(texty1-0.01cm) w:(textw+0.01cm) h:(texth+0.01cm)
 TEXT \"The product viewpoint depicts the value that these products offer to the customers or other e"
	      "xternal parties involved and shows the composition of one or more products in terms of the constituti"
	      "ng (business, application, or technology) services, and the associated contract(s) or other agreement"
	      "s. It may also be used to show the interfaces (channels) through which this product is offered, and t"
	      "he events associated with the product. A product viewpoint is typically used in product development t"
	      "o design a product by composing existing services or by identifying which new services have to be cre"
	      "ated for this product, given the value a customer expects from it. It may then serve as input for bus"
	      "iness process architects and others that need to design the processes and ICT realizing these product"
	      "s.\" x:0.5cm w:10cm h:t y:(y+1.8cm) line-break:words
 POLYGON 3 x1:0.6cm y1:(y+1.1cm) x2:0.9cm y2:(y+1.1cm) x3:0.75cm y3:(y+1.4cm)
}
ELSE { 
 POLYGON 3 x1:0.6cm y1:(y+1.4cm) x2:0.9cm y2:(y+1.25cm) x3:0.6cm y3:(y+1.1cm)
}"

	ATTRIBUTE <Application Usage Viewpoint GraphRep>
	VALUE "GRAPHREP layer:1000 sizing:asymmetrical
 AVAL name:\"Name\" # model name
 AVAL type:\"Type\" # model type name
 AVAL count:\"Number of objects and relations\"
 SET y:0.5cm
 FONT \"Arial\" h:20pt color:black
 TEXT (name + \" (\" + type + \")\") x:0.5cm y:(y) w:l h:t
 SET y:(y + 20pt + 0.3cm)
 FONT \"Arial\" h:11pt color:black
 TEXT (\"Object count: \" + count) x:0.5cm y:(y) w:l h:t

SET y:1cm
FILL color:dodgerblue
RECTANGLE x:0.5cm y:(y+1cm) w:2.5cm h:0.5cm
FILL color:white
FONT color:white
TEXT \"Help\" x:1.5cm y:(y+1cm)

HOTSPOT \"Application Usage Viewpoint Description\" x:0.5cm y:(y+1cm) w:2.5cm h:0.5cm

AVAL blh:\"Application Usage Viewpoint Help\"
IF (VAL blh = 1) {
 FONT color:black
 TEXTBOX \"The application usage viewpoint describes how applications are used to support one or more"
	      " business processes, and how they are used by other applications. It can be used in designing an appl"
	      "ication by identifying the services needed by business processes and other applications, or in design"
	      "ing business processes by describing the services that are available. Furthermore, since it identifie"
	      "s the dependencies of business processes upon applications, it may be useful to operational managers "
	      "responsible for these processes.\" x:0.5cm w:10cm h:t y:(y+1.8cm) line-break:words
FILL color:white
RECTANGLE x:(textx1-0.03cm) y:(texty1-0.01cm) w:(textw+0.01cm) h:(texth+0.01cm)
 TEXT \"The application usage viewpoint describes how applications are used to support one or more bu"
	      "siness processes, and how they are used by other applications. It can be used in designing an applica"
	      "tion by identifying the services needed by business processes and other applications, or in designing"
	      " business processes by describing the services that are available. Furthermore, since it identifies t"
	      "he dependencies of business processes upon applications, it may be useful to operational managers res"
	      "ponsible for these processes.\" x:0.5cm w:10cm h:t y:(y+1.8cm) line-break:words
 POLYGON 3 x1:0.6cm y1:(y+1.1cm) x2:0.9cm y2:(y+1.1cm) x3:0.75cm y3:(y+1.4cm)
}
ELSE { 
 POLYGON 3 x1:0.6cm y1:(y+1.4cm) x2:0.9cm y2:(y+1.25cm) x3:0.6cm y3:(y+1.1cm)
}"

