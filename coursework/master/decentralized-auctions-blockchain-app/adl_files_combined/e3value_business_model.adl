RELATION <Value Transfer>
	FROM <Port-15725> : <Value Port>
	TO <Port-16228> : <Value Port>

	ATTRIBUTE <Positions>
	VALUE "EDGE 1 x1:17.5cm y1:4.5cm index:52 MIDDLE x:17.5cm y:7.33cm"

	ATTRIBUTE <Override Network>
	VALUE ""

	ATTRIBUTE <Color>
	VALUE "EXPR expr:(
set(net, aval(\"Network\")),
cond(net, aval(net, \"Color\"), \"\")
) val:\"$014dbe\""

	ATTRIBUTE <Value Object>
	VALUE "Reward for participating in auction"

	ATTRIBUTE <Off-chain>
	VALUE 0

	ATTRIBUTE <Sensitive>
	VALUE 0

	ATTRIBUTE <Information Exposure>
	VALUE "EXPR expr:(
set(is_sensitive, aval(\"Sensitive\")),
set(is_offchain, aval(\"Off-chain\")),
set(net, aval(\"Network\")),
cond(is_sensitive AND NOT is_offchain AND net AND aval(net, \"Access\") != \"permissioned\", 1, 0)
) val:0"

	ATTRIBUTE <Network>
	VALUE "EXPR expr:(
set(portfrom, ctobj()),
set(portto, cfobj()),
set(nets_inter, tokisect(aval(portfrom, \"Networks\"), aval(portto, \"Networks\"))),
set(nets_union, tokunion(aval(portfrom, \"Networks\"), aval(portto, \"Networks\"))),
set(is_intra_net, (tokcnt(nets_inter) > 0)),
set(override, aval(\"Override Network\")),
set(has_override, LEN override > 0),
set(selectednet, \"\"),
set(candidates, \"\"),
fortok(net, nets_union, \" \", 
   cond((aval(VAL net, \"Access\") = \"public\"), set(candidates, tokcat(candidates, net)), \"\")
),
cond(has_override, set(selectednet, aql(\"{\\\"\"+override+\"\\\"}\")), \"\"),
