INSTANCE <Port-15725> : <Value Port>

	ATTRIBUTE <Position>
	VALUE "NODE x:17.5cm y:8cm index:25"

	ATTRIBUTE <External tool coupling>
	VALUE ""

	ATTRIBUTE <Networks>
	VALUE "EXPR expr:(
aql(\"{\\\"\"+aval(\"Name\")+\"\\\"}->\\\"Is inside\\\">\\\"Network\\\"<\")
) val:\"18775\""

	ATTRIBUTE <Direction>
	VALUE "EXPR expr:(
set(vali, aql(\"{\\\"\"+aval(\"Name\")+\"\\\"}->\\\"Is inside\\\">\\\"Value Interface\\\"<\")),
set(role, aval(\"Role\")),
set(in_vali, LEN vali > 0),
set(port_dir, -1),
set(vali_or, -1),
set(other_pos, \"\"),
set(other_pos_x, -1),
set(other_pos_y, -1),
set(this_pos, aval(\"Position\")),
set(this_pos_x, VAL replall(replall(copy(this_pos, search(this_pos, \"x:\", 0)+2, 3), \"c\", \"\"), \""
	      "m\", \"\")),
set(this_pos_y, VAL replall(replall(copy(this_pos, search(this_pos, \"y:\", 0)+2, 3), \"c\", \"\"), \""
	      "m\", \"\")),
cond(in_vali, set(vali_or, aval(VAL vali, \"Orientation\")), -1),
cond(role = \"in\", set(other_pos, aval(VAL cfobjs(\"Value Transfer\"), \"Position\")), \"\"),
cond(role = \"out\", set(other_pos, aval(VAL ctobjs(\"Value Transfer\"), \"Position\")), \"\"),
cond(LEN other_pos > 0, set(other_pos_x, VAL replall(replall(copy(other_pos, search(other_pos, \"x:\""
	      ", 0)+2, 3), \"c\", \"\"), \"m\", \"\")), \"\"),
cond(LEN other_pos > 0, set(other_pos_y, VAL replall(replall(copy(other_pos, search(other_pos, \"y:\""
	      ", 0)+2, 3), \"c\", \"\"), \"m\", \"\")), \"\"),
cond(vali_or = 0 AND role = \"in\", 
     cond(this_pos_y > other_pos_y, set(port_dir, \"s\"), set(port_dir, \"n\")), \"\"),
cond(vali_or = 0 AND role = \"out\", 
     cond(this_pos_y > other_pos_y, set(port_dir, \"n\"), set(port_dir, \"s\")), \"\"),
cond(vali_or = 1 AND role = \"in\", 
     cond(this_pos_x > other_pos_x, set(port_dir, \"e\"), set(port_dir, \"w\")), \"\"),
cond(vali_or = 1 AND role = \"out\", 
     cond(this_pos_x > other_pos_x, set(port_dir, \"w\"), set(port_dir, \"e\")), \"\"),
port_dir
) val:\"n\""

	ATTRIBUTE <Role>
	VALUE "EXPR expr:(
cond((LEN ctobjs(\"Value Transfer\") > 0), \"out\", cond((LEN cfobjs(\"Value Transfer\")), \"in\", \""
	      "none\"))
) val:\"out\""


