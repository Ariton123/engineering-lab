############################################################
# TaskWeaver - Workflow Execution (Dynamic Semantic Prototype)
# Final Project - Metamodeling
#
# ROCKSTAR GUARDED VERSION:
# - Uses ACTIVE model context if provided via gTWModelId
# - Otherwise falls back to manual selection
# - Traverses ONLY workflow nodes (Event/Task/Gateway)
# - SKIPS DataObject connectors (dashed associations)
# - Prevents Event -> Event transitions
# - Stops gracefully with clear messages
############################################################

# ----------------------------------------------------------
# 0) Acquire model context
# ----------------------------------------------------------
SET local_modelid:0

# If triggered by external coupling, gTWModelId is set
# If not set, it will typically behave like 0
IF (gTWModelId > 0) {
    SET local_modelid:(gTWModelId)
}

# Manual fallback (for running from Extras -> Execute AdoScript)
IF (local_modelid = 0) {
    CC "CoreUI" MODEL_SELECT_BOX modeltype:"Workflow Model"
    SET local_modelid:(VAL modelids)
}

IF (local_modelid = 0) {
    CC "AdoScript" INFOBOX ("[TaskWeaver] No model context available. Aborted.")
    EXIT
}

# ----------------------------------------------------------
# 1) Load model if needed
# ----------------------------------------------------------
CC "Core" IS_MODEL_LOADED modelid:(local_modelid)
SET wasloaded:(isloaded)

IF (NOT wasloaded) {
    CC "Core" LOAD_MODEL modelid:(local_modelid)
}

CC "AdoScript" INFOBOX ("[TaskWeaver] Execution started.")

# ----------------------------------------------------------
# 2) Collect node sets (used to identify valid traversal nodes)
# ----------------------------------------------------------
CC "Core" GET_ALL_OBJS_OF_CLASSNAME modelid:(local_modelid) classname:"Event"
SET events:(objids)

CC "Core" GET_ALL_OBJS_OF_CLASSNAME modelid:(local_modelid) classname:"Task"
SET tasks:(objids)

CC "Core" GET_ALL_OBJS_OF_CLASSNAME modelid:(local_modelid) classname:"Gateway"
SET gateways:(objids)

CC "Core" GET_ALL_OBJS_OF_CLASSNAME modelid:(local_modelid) classname:"Data object"
SET dataobjects:(objids)

# Basic sanity: must contain core workflow classes
IF ((events = "") OR (tasks = "") OR (gateways = "")) {
    CC "AdoScript" INFOBOX ("[TaskWeaver] This model does not look like a Workflow Model instance (missing Event/Task/Gateway). Aborted.")
    IF (NOT wasloaded) { CC "Core" DISCARD_MODEL modelid:(local_modelid) }
    SETG gTWModelId:(0)
    EXIT
}

# ----------------------------------------------------------
# 3) Find exactly ONE Start Event
# ----------------------------------------------------------
SET startId:0
SET startCount:0

FOR e in:(events) sep:" " {
    CC "Core" GET_ATTR_VAL objid:(VAL e) attrname:"Type"
    IF (val = "Start") {
        SET startCount:(startCount + 1)
        SET startId:(VAL e)
    }
}

IF (startCount != 1) {
    CC "AdoScript" INFOBOX ("[TaskWeaver] Invalid number of Start Events (" + STR(startCount) + "). Execution aborted.")
    IF (NOT wasloaded) { CC "Core" DISCARD_MODEL modelid:(local_modelid) }
    SETG gTWModelId:(0)
    EXIT
}

SET currentNode:(startId)
CC "AdoScript" INFOBOX ("[TaskWeaver] Reached Start Event.")

# ----------------------------------------------------------
# Helper: check membership in a list (space-separated objids)
# Returns 1 or 0 in variable 'isIn'
# ----------------------------------------------------------
# Usage pattern:
#   SET isIn:0
#   FOR x in:(list) sep:" " { IF (VAL x = someid) { SET isIn:1 BREAK } }

# ----------------------------------------------------------
# 4) Traversal loop
#    - always choose NEXT NODE among Event/Task/Gateway
#    - SKIP DataObjects (dashed associations)
# ----------------------------------------------------------
SET finished:0
SET stepCount:0
SET stepLimit:200

WHILE (finished = 0) {

    SET stepCount:(stepCount + 1)
    IF (stepCount > stepLimit) {
        CC "AdoScript" INFOBOX ("[TaskWeaver] Step limit exceeded (" + STR(stepLimit) + "). Possible loop. Aborted.")
        SET finished:1
        BREAK
    }

    # ---- Determine current node kind (Event/Task/Gateway) ----
    SET curIsEvent:0
    FOR e in:(events) sep:" " {
        IF (VAL e = currentNode) { SET curIsEvent:1 BREAK }
    }

    SET curIsTask:0
    FOR t in:(tasks) sep:" " {
        IF (VAL t = currentNode) { SET curIsTask:1 BREAK }
    }

    SET curIsGateway:0
    FOR g in:(gateways) sep:" " {
        IF (VAL g = currentNode) { SET curIsGateway:1 BREAK }
    }

    # If current node is none of the valid node kinds, stop
    IF ((curIsEvent = 0) AND (curIsTask = 0) AND (curIsGateway = 0)) {
        CC "AdoScript" INFOBOX ("[TaskWeaver] Invalid current node (not Event/Task/Gateway). Execution aborted.")
        SET finished:1
        BREAK
    }

    # Current node type (for narration)
    CC "Core" GET_ATTR_VAL objid:(currentNode) attrname:"Type"
    SET curType:(val)

    # End condition
    IF (curIsEvent = 1) {
        IF (curType = "End") {
            CC "AdoScript" INFOBOX ("[TaskWeaver] Reached End Event. Execution finished.")
            SET finished:1
            BREAK
        }
        IF (curType = "Error") {
            CC "AdoScript" INFOBOX ("[TaskWeaver] Reached ERROR Event. Execution finished (error path).")
            SET finished:1
            BREAK
        }
    }

    # ---- Get outgoing connectors ----
    CC "Core" GET_CONNECTORS objid:(currentNode) out
    SET conns:(objids)

    IF (conns = "") {
        CC "AdoScript" INFOBOX ("[TaskWeaver] No outgoing flow from node (" + curType + "). Execution stopped.")
        SET finished:1
        BREAK
    }

    # ---- Select next workflow node:
    #      pick the first connector whose target is Event/Task/Gateway
    #      skip connectors to DataObject
    SET nextNode:0

    FOR c in:(conns) sep:" " {

        CC "Core" GET_CONNECTOR_ENDPOINTS objid:(VAL c)
        SET candidate:(toobjid)

        # Skip invalid targets
        IF (candidate = 0) { }

        # Is candidate a DataObject? If yes -> skip
        SET isData:0
        FOR d in:(dataobjects) sep:" " {
            IF (VAL d = candidate) { SET isData:1 BREAK }
        }
        IF (isData = 1) { }

        # Is candidate a valid workflow node?
        SET isNode:0

        FOR e in:(events) sep:" " {
            IF (VAL e = candidate) { SET isNode:1 BREAK }
        }
        IF (isNode = 0) {
            FOR t in:(tasks) sep:" " {
                IF (VAL t = candidate) { SET isNode:1 BREAK }
            }
        }
        IF (isNode = 0) {
            FOR g in:(gateways) sep:" " {
                IF (VAL g = candidate) { SET isNode:1 BREAK }
            }
        }

        IF (isNode = 1) {
            SET nextNode:(candidate)
            BREAK
        }
    }

    IF (nextNode = 0) {
        CC "AdoScript" INFOBOX ("[TaskWeaver] No valid next workflow node found (only DataObjects / invalid links). Execution stopped.")
        SET finished:1
        BREAK
    }

    # ---- Determine next node kind + type ----
    SET nextIsEvent:0
    FOR e in:(events) sep:" " { IF (VAL e = nextNode) { SET nextIsEvent:1 BREAK } }

    SET nextIsTask:0
    FOR t in:(tasks) sep:" " { IF (VAL t = nextNode) { SET nextIsTask:1 BREAK } }

    SET nextIsGateway:0
    FOR g in:(gateways) sep:" " { IF (VAL g = nextNode) { SET nextIsGateway:1 BREAK } }

    CC "Core" GET_ATTR_VAL objid:(nextNode) attrname:"Type"
    SET nextType:(val)

    # ------------------------------------------------------
    # HARD CONSTRAINT: forbid Event -> Event
    # ------------------------------------------------------
    IF ((curIsEvent = 1) AND (nextIsEvent = 1)) {
        CC "AdoScript" INFOBOX ("[TaskWeaver] INVALID STRUCTURE: Event -> Event (" + curType + " -> " + nextType + "). Aborted.")
        SET finished:1
        BREAK
    }

    # ------------------------------------------------------
    # Narration (presentation-safe)
    # ------------------------------------------------------

    # Start -> Task
    IF ((curIsEvent = 1) AND (curType = "Start")) {
        IF (nextIsTask = 0) {
            CC "AdoScript" INFOBOX ("[TaskWeaver] INVALID: Start must lead to a Task. Found (" + nextType + "). Aborted.")
            SET finished:1
            BREAK
        }

        CC "AdoScript" INFOBOX ("[TaskWeaver] Executing Task (" + nextType + ")")
        CC "AdoScript" INFOBOX ("-> Consuming CSV Data Object as input")
    }

    # Parallel Gateway: narrate ALL branches dynamically
    IF ((curIsGateway = 1) AND (curType = "Parallel")) {

        CC "Core" GET_CONNECTORS objid:(currentNode) out
        SET gwConns:(objids)

        # Build a comma-separated list of branch task types
        SET branchMsg:""
        SET branchCount:0

        FOR gc in:(gwConns) sep:" " {

            CC "Core" GET_CONNECTOR_ENDPOINTS objid:(VAL gc)
            SET bnode:(toobjid)

            # Skip dataobjects
            SET isData:0
            FOR d in:(dataobjects) sep:" " {
                IF (VAL d = bnode) { SET isData:1 BREAK }
            }
            IF (isData = 1) { }

            # only consider Tasks as branches (your semantics)
            SET isTask:0
            FOR t in:(tasks) sep:" " {
                IF (VAL t = bnode) { SET isTask:1 BREAK }
            }

            IF (isTask = 1) {
                CC "Core" GET_ATTR_VAL objid:(bnode) attrname:"Type"
                IF (branchCount = 0) {
                    SET branchMsg:(val)
                } ELSE {
                    SET branchMsg:(branchMsg + ", " + val)
                }
                SET branchCount:(branchCount + 1)
            }
        }

        CC "AdoScript" INFOBOX ("[TaskWeaver] Parallel Gateway - executing all branches (" + STR(branchCount) + "): " + branchMsg)

        # Optional: mention data objects in your story
        CC "AdoScript" INFOBOX ("-> SQL branch writes to Database Data Object")
    }

    # Exclusive Gateway: narration only (prototype chooses first valid branch)
    IF ((curIsGateway = 1) AND (curType = "Exclusive")) {
        CC "AdoScript" INFOBOX ("[TaskWeaver] Exclusive Gateway - selecting one branch (prototype: first valid)")
    }

    # If next is Output Task, narrate JSON
    IF (nextIsTask = 1) {
        IF (nextType = "Output") {
            CC "AdoScript" INFOBOX ("[TaskWeaver] Executing Task (Output)")
            CC "AdoScript" INFOBOX ("-> Producing JSON Data Object as output")
        }
    }

    # If next is Error Event, finish (handled at top too, but safe here)
    IF (nextIsEvent = 1) {
        IF (nextType = "Error") {
            CC "AdoScript" INFOBOX ("[TaskWeaver] ERROR path reached. Execution finished (error path).")
            SET finished:1
            BREAK
        }
    }

    # Move forward
    SET currentNode:(nextNode)
}

# ----------------------------------------------------------
# 5) Cleanup
# ----------------------------------------------------------
IF (NOT wasloaded) {
    CC "Core" DISCARD_MODEL modelid:(local_modelid)
}

# Clear global context so it doesn't leak
SETG gTWModelId:(0)

CC "AdoScript" INFOBOX ("[TaskWeaver] Execution completed.")
